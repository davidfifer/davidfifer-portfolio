# ============================
# Global ignores
# ============================

# OS junk
.DS_Store
Thumbs.db

# Editor / IDE
.idea/
.vscode/
*.swp

# ============================
# Java / Maven / Spring Boot
# ============================

# Maven target directory
target/

# Build artifacts
*.class
*.jar
*.war
*.ear

# Logs
*.log

# Spring Boot DevTools
spring-devtools.properties

# ============================
# Python
# ============================

# Virtual environments
venv/
.env/
.envrc

# Bytecode
__pycache__/
*.pyc
*.pyo

# Packaging
build/
dist/
*.egg-info/

# ============================
# Node / Frontend (future-proof)
# ============================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================
# Docker
# ============================

# Local Docker artifacts
*.pid
*.seed
*.pid.lock

# ============================
# IntelliJ / PyCharm (project-level)
# ============================

# Allow subproject-level IntelliJ configs if needed
!java/**/.idea/
!python/**/.idea/

# But ignore noisy IntelliJ files everywhere
**/.idea/workspace.xml
**/.idea/shelf/
**/.idea/dataSources/
**/.idea/httpRequests/
**/.idea/dictionaries/
**/*.iml

# ============================
# Misc
# ============================

# Temporary files
tmp/
.cache/
